NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_api_key_here

# Google reCAPTCHA v2 checkbox protects the public contact form from automated spam.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_v2_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_v2_secret_key

# Canonical site URL (Open Graph, metadataBase)
NEXT_PUBLIC_SITE_URL=https://sabarytours.com

# Optional social profile overrides (defaults are Sabary Tours official links in app/lib/socialLinks.ts).
# NEXT_PUBLIC_SOCIAL_FACEBOOK=https://facebook.com/yourpage
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://instagram.com/yourprofile
